# ==============================================================================
# AAISE Environment Configuration Template
# Copy this file to .env and insert your real credentials locally.
# DO NOT COMMIT THE REAL .env FILE TO GIT (enforced via .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# Cloud LLM Provider API Keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# Local Ollama LLM Configuration (Docker container: dobai-ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------------------------
# Microsoft SQL Server Database Connection
# ------------------------------------------------------------------------------
SQL_SERVER_HOST=localhost
SQL_SERVER_DATABASE=AI_SoftwareEngineer
SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER_TRUSTED_CONNECTION=yes
